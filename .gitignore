# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/

# Production build artifacts
build
dist

# Environment variables & secrets — NEVER commit real credentials
.env
.env.local
.env*.local
.env.production
.env.production.local
.env.staging
.env.development.local

# Local Database & WAL files
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# Local Media Storage (keep originals and HLS out of Git)
/public/uploads/*
!/public/uploads/.gitkeep
/public/streams/*
!/public/streams/.gitkeep
/media_storage/*
!/media_storage/.gitkeep
/data/velora/*
/data/chiller/*

# Logs & Runtime telemetry
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Editor & OS files
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
Desktop.ini

# Test & debug artifacts
*.test.db
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Temporary files
*.tmp
*.temp
