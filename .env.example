# ============================================================================
# CHILLER Streaming Platform - Environment Configuration Template
# Brand: CHILLER | Tagline: JUST CHILL. | Supporting: GOOD STORIES. BETTER DAYS.
# ============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env
#   2. Fill in your real values (marked REQUIRED)
#   3. NEVER commit .env to version control — it is in .gitignore
#   4. Only TMDB_API_KEY is required to start. All other providers are optional.
# ============================================================================

# ==========================================
# CHILLER CORE
# ==========================================

NEXT_PUBLIC_APP_NAME="CHILLER"
NEXT_PUBLIC_APP_TAGLINE="JUST CHILL."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

DATABASE_URL="file:./prisma/dev.db"

# Generate a secure random value: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_secure_random_32_character_string"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# SUPER_ADMIN ACCESS POLICY
# Only exact email matches are authorized as SUPER_ADMIN.
# Use comma-separated list for multiple accounts.
# SUPER_ADMIN_BOOTSTRAP_PASSWORD must go in .env.local ONLY — NEVER commit it.
# Run `npm run seed:admin` after setting both vars to bootstrap accounts.
# ==========================================
SUPER_ADMIN_EMAILS="your-email@example.com"
# In .env.local only (never here):
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=your_strong_temporary_password

STREAMING_SIGNING_SECRET="replace_with_a_secure_stream_signing_secret"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./media_storage"
KEEP_ORIGINAL_FILES="true"
ALLOWED_EMBED_DOMAINS="*"
ALLOWED_IMPORT_ROOTS="./media_storage/videos/original"
AD_ENABLED="false"

# ==========================================
# TMDB — PRIMARY METADATA & DISCOVERY (REQUIRED)
# ==========================================

# Get credentials at: https://www.themoviedb.org/settings/api
# TMDB_API_KEY is used for query-param auth (v3)
# TMDB_ACCESS_TOKEN is used for Bearer auth (v4 read access token)
TMDB_API_KEY=""
TMDB_ACCESS_TOKEN=""

# ==========================================
# ANIME (OPTIONAL INTELLIGENCE PROVIDERS)
# ==========================================

ANILIST_ENABLED=true
ANILIST_API_URL=https://graphql.anilist.co

JIKAN_ENABLED=true
JIKAN_API_URL=https://api.jikan.moe/v4

# ==========================================
# TV (OPTIONAL ENRICHMENT PROVIDER)
# ==========================================

TVMAZE_ENABLED=true
TVMAZE_API_URL=https://api.tvmaze.com

# ==========================================
# THETVDB (OPTIONAL METADATA PROVIDER)
# ==========================================

THETVDB_ENABLED=false
THETVDB_API_URL=https://api4.thetvdb.com
THETVDB_API_KEY=

# ==========================================
# AVAILABILITY (WHERE TO WATCH — NOT PLAYBACK)
# ==========================================

WATCHMODE_ENABLED=false
WATCHMODE_API_URL=https://api.watchmode.com
WATCHMODE_API_KEY=

# ==========================================
# SUBTITLES (OPTIONAL PROVIDER)
# ==========================================

OPENSUBTITLES_ENABLED=false
OPENSUBTITLES_API_URL=https://api.opensubtitles.com/api/v1
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# ==========================================
# PLAYBACK PROVIDERS — MULTI-PROVIDER FALLBACK ENGINE
# Resolution order: CineSrc(1) → VidSrc(2) → Vidking(3) → CodeSpecter(4) → Aggregator(5) → NHD(6)
# Free providers (CineSrc, VidSrc) require no API key.
# ==========================================

# 1. CineSrc (Priority 1 — Free, no key, documented postMessage events)
CINESRC_ENABLED=true
CINESRC_BASE_URL=https://cinesrc.st

# 2. VidSrc (Priority 2 — Free, no key, active host: vidsrc.sbs)
VIDSRC_ENABLED=true
VIDSRC_BASE_URL=https://vidsrc.sbs

# 3. Vidking (Priority 3 — Optional, set to true to activate)
VIDKING_ENABLED=false
VIDKING_BASE_URL=https://www.vidking.net

# 4. NexStream / CodeSpecter (Priority 4 — Requires API key)
CODESPECTER_ENABLED=false
CODESPECTER_API_URL=https://api.codespecters.com
CODESPECTER_API_KEY=

# 5. Self-Hosted Playback Aggregator (Priority 5 — Requires URL)
PLAYBACK_AGGREGATOR_ENABLED=false
PLAYBACK_AGGREGATOR_URL=

# 6. NHD Embed (Priority 6 — Anime support via AniList ID, optional key)
NHD_ENABLED=true
NHD_API_URL=https://nhdapi.st
NHD_API_KEY=

# ==========================================
# CHILLER CANDIDATE PLAYBACK SOURCE DIRECTORY
# Keep unconfigured providers false by default.
# Tokens and credentials must remain server-side.
# ==========================================

# A. FileMoon (Documented API v1, Bearer token, HLS/Embed)
FILEMOON_ENABLED=false
FILEMOON_API_URL=https://filemoon.org/api/v1
FILEMOON_API_TOKEN=

# B. VdoHide (HLS Streaming / Unlimited Bandwidth / Embed)
VDOHIDE_ENABLED=false
VDOHIDE_API_URL=https://vdohide.com/api
VDOHIDE_API_KEY=

# C. StreamTape (Official API v1 / Login + Key Auth)
STREAMTAPE_ENABLED=false
STREAMTAPE_API_URL=https://api.streamtape.com
STREAMTAPE_API_LOGIN=
STREAMTAPE_API_KEY=

# D. EarnVids (Video Service Slot - Keep false until API provided)
EARNVIDS_ENABLED=true
EARNVIDS_API_URL=
EARNVIDS_API_KEY=

# E. Vidstream (Streaming Source Slot)
VIDSTREAM_ENABLED=false
VIDSTREAM_API_URL=
VIDSTREAM_API_KEY=

# F. VidStreaming (Video Host Slot)
VIDSTREAMING_ENABLED=false
VIDSTREAMING_API_URL=
VIDSTREAMING_API_KEY=

# G. Dailymotion (Official API v2 & Web Player)
DAILYMOTION_ENABLED=false
DAILYMOTION_PLAYER_ID=x7s6f
DAILYMOTION_API_KEY=

# H. Self-Hosted Media Servers
JELLYFIN_ENABLED=false
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

PLEX_ENABLED=false
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# I. Cloud Media & AVOD Platforms
MYCLOUD_ENABLED=false
MEGACLOUD_ENABLED=false
MEGAUP_ENABLED=false
TUBI_ENABLED=false
ROKU_ENABLED=false
PLUTO_ENABLED=false

